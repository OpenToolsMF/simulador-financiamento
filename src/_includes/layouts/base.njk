<!doctype html>
<html lang="{{ generatedPage.htmlLang }}">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-8QCFQMHCZ3"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-8QCFQMHCZ3', {
        page_location: window.location.origin + window.location.pathname,
        page_path: window.location.pathname
      });
    </script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{ generatedPage.description }}">
    {% if generatedPage.adsense %}<meta name="google-adsense-account" content="ca-pub-8780410675865678">
    {% endif %}<title>{{ generatedPage.title }}</title>
    <link rel="canonical" href="{{ generatedPage.publicPath | canonicalUrl }}">
    {% for alternate in generatedPage.alternates %}<link rel="alternate" hreflang="{{ alternate.locale }}" href="{{ alternate.publicPath | canonicalUrl }}">
    {% endfor %}<link rel="alternate" hreflang="x-default" href="{{ generatedPage.alternates[0].publicPath | canonicalUrl }}">
    <meta property="og:type" content="{{ generatedPage.ogType }}">
    <meta property="og:locale" content="{{ generatedPage.ogLocale }}">
    <meta property="og:site_name" content="{{ 'header.title' | t(generatedPage.locale) }}">
    <meta property="og:title" content="{{ generatedPage.title }}">
    <meta property="og:description" content="{{ generatedPage.description }}">
    <meta property="og:url" content="{{ generatedPage.publicPath | canonicalUrl }}">
    {% set socialImagePath = generatedPage.socialImage.path if generatedPage.socialImage else 'assets/image/logo.png' %}
    {% set socialImageType = generatedPage.socialImage.type if generatedPage.socialImage else 'image/png' %}
    {% set socialImageWidth = generatedPage.socialImage.width if generatedPage.socialImage else 600 %}
    {% set socialImageHeight = generatedPage.socialImage.height if generatedPage.socialImage else 600 %}
    {% set socialImageAlt = generatedPage.socialImage.alt if generatedPage.socialImage else site.localizedSchema[generatedPage.locale].imageAlt %}
    <meta property="og:image" content="{{ site.origin }}/{{ socialImagePath }}">
    <meta property="og:image:type" content="{{ socialImageType }}">
    <meta property="og:image:width" content="{{ socialImageWidth }}">
    <meta property="og:image:height" content="{{ socialImageHeight }}">
    <meta property="og:image:alt" content="{{ socialImageAlt }}">
    <meta name="twitter:card" content="{{ 'summary_large_image' if generatedPage.socialImage else 'summary' }}">
    <meta name="twitter:title" content="{{ generatedPage.title }}">
    <meta name="twitter:description" content="{{ generatedPage.description }}">
    <meta name="twitter:image" content="{{ site.origin }}/{{ socialImagePath }}">
    <meta name="twitter:image:alt" content="{{ socialImageAlt }}">
    <script type="application/ld+json">
{{ generatedPage | structuredData | json | safe }}
    </script>
    {% if generatedPage.adsense %}<script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8780410675865678" crossorigin="anonymous"></script>
    {% endif %}<link rel="icon" type="image/svg+xml" href="{{ 'assets/image/favicon/favicon.svg' | assetHref(generatedPage) }}">
    <link rel="icon" type="image/png" sizes="96x96" href="{{ 'assets/image/favicon/favicon-96x96.png' | assetHref(generatedPage) }}">
    <link rel="shortcut icon" href="{{ 'assets/image/favicon/favicon.ico' | assetHref(generatedPage) }}">
    <link rel="apple-touch-icon" sizes="180x180" href="{{ 'assets/image/favicon/apple-touch-icon.png' | assetHref(generatedPage) }}">
    <link rel="manifest" href="{{ 'assets/image/favicon/site.webmanifest' | assetHref(generatedPage) }}">
    <link rel="stylesheet" href="{{ 'assets/vendor/bootstrap/css/bootstrap.min.css' | assetHref(generatedPage) }}">
    <link rel="stylesheet" href="{{ ('assets/css/styles.css?v=' + generatedPage.styleVersion) | assetHref(generatedPage) }}">
  </head>
  <body{% if generatedPage.bodyClass %} class="{{ generatedPage.bodyClass }}"{% endif %}>
    {% include "components/site-header.njk" %}

{{ content | safe }}

    {% if not generatedPage.footerInContent %}{% include "components/site-footer.njk" %}
    {% endif %}

    {% for script in generatedPage.scripts %}<script src="{{ script | assetHref(generatedPage) }}"></script>
    {% endfor %}</body>
</html>

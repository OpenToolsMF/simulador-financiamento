    <header class="site-header">
      <div class="container {{ generatedPage.headerPadding }}">
        <div class="site-header-content">
          <div class="site-header-topline">
            <span class="eyebrow"{% if generatedPage.institutional %} data-i18n="{{ generatedPage.headerKeys[0] }}"{% endif %}>{{ generatedPage.headerEyebrow }}</span>
            <div class="language-switcher">
              <label for="language-select" class="form-label"{% if generatedPage.institutional %} data-i18n="language.label"{% endif %}>{{ 'language.label' | t(generatedPage.locale) }}</label>
              <select id="language-select" class="form-select form-select-sm" aria-label="{{ 'language.label' | t(generatedPage.locale) }}"{% if generatedPage.institutional %} data-i18n-aria-label="language.label"{% endif %}>
                {% for language in site.locales %}<option value="{{ language }}"{% if generatedPage.institutional %} data-i18n="language.{{ language }}"{% endif %}{% if language == generatedPage.locale %} selected{% endif %}>{{ ('language.' + language) | t(generatedPage.locale) }}</option>
                {% endfor %}</select>
            </div>
          </div>
          <h1 class="display-6 fw-bold mb-2"{% if generatedPage.institutional %} data-i18n="{{ generatedPage.headerKeys[1] }}"{% endif %}>{{ generatedPage.headerTitle }}</h1>
          <p class="lead mb-0"{% if generatedPage.institutional %} data-i18n="{{ generatedPage.headerKeys[2] }}"{% endif %}>{{ generatedPage.headerLead }}</p>
          <nav class="site-primary-nav" aria-label="{{ 'nav.label' | t(generatedPage.locale) }}">
            {% for route in ['simulator', 'comparison', 'guides'] %}<a href="{{ route | pageHref(generatedPage) }}" data-route="{{ route }}"{% if route == generatedPage.pageKey %} aria-current="page"{% endif %} data-i18n="footer.{{ route }}">{{ ('footer.' + route) | t(generatedPage.locale) }}</a>
            {% endfor %}</nav>
        </div>
      </div>
    </header>

---
layout: layouts/base.njk
pagination:
  data: site.pageGroups.simulator
  size: 1
  alias: generatedPage
permalink: "{{ generatedPage.outputPath }}"
---

    <main class="container py-4 py-lg-5">
      <aside id="simulation-link-notice" class="simulation-link-notice d-none no-print" role="status" aria-live="polite">
        <p id="simulation-link-message"></p>
        <div class="d-flex gap-2 flex-wrap">
          <button id="restore-saved-simulation" class="btn btn-outline-primary btn-sm d-none" type="button">{{ 'simulationLink.restore' | t(generatedPage.locale) }}</button>
          <button id="dismiss-simulation-link-notice" class="btn btn-outline-secondary btn-sm" type="button">{{ 'simulationLink.dismiss' | t(generatedPage.locale) }}</button>
        </div>
      </aside>

      <form id="simulation-form" novalidate>
        <section class="surface-card mb-4" aria-labelledby="financing-title">
          <div class="section-heading">
            <div>
              <span class="section-kicker">{{ "config.kicker" | t(generatedPage.locale) | safe }}</span>
              <h2 id="financing-title">{{ "config.title" | t(generatedPage.locale) | safe }}</h2>
            </div>
            <div class="section-actions">
              <button id="export-pdf" class="btn btn-outline-primary btn-sm no-print" type="button" disabled>{{ "results.exportPdf" | t(generatedPage.locale) | safe }}</button>
              <button id="reset-form" class="btn btn-outline-secondary btn-sm" type="button">{{ "config.reset" | t(generatedPage.locale) | safe }}</button>
            </div>
          </div>

          <aside id="privacy-notice" class="privacy-notice" aria-labelledby="privacy-notice-title">
            <button id="privacy-notice-dismiss" class="btn-close privacy-notice-dismiss" type="button" aria-label="{{ "privacyNotice.dismissAria" | t(generatedPage.locale) | safe }}"></button>
            <p class="mb-0">
              <strong id="privacy-notice-title">{{ "privacyNotice.title" | t(generatedPage.locale) | safe }}</strong>
              <span id="privacy-notice-text">{{ "privacyNotice.text" | t(generatedPage.locale) | safe }}</span>
            </p>
          </aside>

          <div class="row row-cols-1 row-cols-md-2 row-cols-xl-5 g-4 financing-config-grid">
            <div class="col financing-config-field">
              <div class="field-header">
                <label for="financed-value" class="form-label">{{ "form.financedValue" | t(generatedPage.locale) | safe }} <span class="required-marker" aria-hidden="true">*</span></label>
              </div>
              <div class="input-group has-validation">
                <span class="input-group-text">R$</span>
                <input id="financed-value" name="financedValue" class="form-control" type="text" inputmode="decimal" autocomplete="off" placeholder="{{ generatedPage.locale | numberPlaceholder }}" aria-describedby="financed-value-error" required>
                <div id="financed-value-error" class="invalid-feedback"></div>
              </div>
            </div>

            <div class="col financing-config-field">
              <div class="field-header">
                <label for="term" class="form-label">{{ "form.term" | t(generatedPage.locale) | safe }} <span class="required-marker" aria-hidden="true">*</span></label>
              </div>
              <div class="input-group has-validation">
                <input id="term" name="term" class="form-control" type="number" min="1" max="600" step="1" inputmode="numeric" value="360" aria-describedby="term-error" required>
                <span class="input-group-text">{{ "unit.months" | t(generatedPage.locale) | safe }}</span>
                <div id="term-error" class="invalid-feedback"></div>
              </div>
            </div>

            <div class="col financing-config-field">
              <div class="field-header">
                <label for="interest-rate" class="form-label">{{ "form.interestRate" | t(generatedPage.locale) | safe }} <span class="required-marker" aria-hidden="true">*</span></label>
                <button id="open-bcb-rates" class="btn btn-outline-primary btn-sm financing-field-action" type="button" data-bs-toggle="modal" data-bs-target="#bcb-rates-modal" aria-label="{{ "form.viewBcbRates" | t(generatedPage.locale) | safe }}" title="{{ "form.viewBcbRates" | t(generatedPage.locale) | safe }}">BCB</button>
              </div>
              <div class="input-group has-validation">
                <input id="interest-rate" name="interestRate" class="form-control" type="text" inputmode="decimal" autocomplete="off" placeholder="{{ generatedPage.locale | numberPlaceholder }}" aria-describedby="interest-rate-error" required>
                <span class="input-group-text">%</span>
                <div id="interest-rate-error" class="invalid-feedback"></div>
              </div>
            </div>

            <div class="col financing-config-field">
              <div class="field-header">
                <label for="rate-period" class="form-label">{{ "form.ratePeriod" | t(generatedPage.locale) | safe }}</label>
              </div>
              <select id="rate-period" name="ratePeriod" class="form-select">
                <option value="annual">{{ "option.rateAnnual" | t(generatedPage.locale) | safe }}</option>
                <option value="monthly">{{ "option.rateMonthly" | t(generatedPage.locale) | safe }}</option>
              </select>
            </div>

            <div id="annual-rate-type-field" class="col financing-config-field">
              <div class="field-header">
                <label for="annual-rate-type" class="form-label">{{ "form.annualRateType" | t(generatedPage.locale) | safe }}</label>
              </div>
              <select id="annual-rate-type" name="annualRateType" class="form-select">
                <option value="effective">{{ "option.annualEffective" | t(generatedPage.locale) | safe }}</option>
                <option value="nominal">Nominal</option>
              </select>
              <div id="annual-rate-type-help" class="form-text d-none"></div>
            </div>

            <div class="col financing-config-field">
              <div class="field-header">
                <label for="monthly-extra-cost" class="form-label">{{ "form.monthlyExtraCost" | t(generatedPage.locale) | safe }}</label>
              </div>
              <div class="input-group has-validation">
                <span class="input-group-text">R$</span>
                <input id="monthly-extra-cost" name="monthlyExtraCost" class="form-control" type="text" inputmode="decimal" autocomplete="off" placeholder="{{ generatedPage.locale | numberPlaceholder }}" aria-describedby="monthly-extra-cost-help monthly-extra-cost-error">
                <div id="monthly-extra-cost-error" class="invalid-feedback"></div>
              </div>
              <div id="monthly-extra-cost-help" class="form-text">{{ "form.monthlyExtraCostHelp" | t(generatedPage.locale) | safe }}</div>
            </div>

            <div class="col financing-config-field">
              <div class="field-header">
                <label for="correction-mode" class="form-label">{{ "form.correctionMode" | t(generatedPage.locale) | safe }}</label>
              </div>
              <select id="correction-mode" name="correctionMode" class="form-select">
                <option value="fixed">{{ "option.correctionFixed" | t(generatedPage.locale) | safe }}</option>
                <option value="custom">{{ "form.customSeries" | t(generatedPage.locale) | safe }}</option>
                <option value="none">{{ "option.correctionNone" | t(generatedPage.locale) | safe }}</option>
              </select>
            </div>

            <div id="fixed-correction-field" class="col financing-config-field financing-config-field-wide d-none">
              <div class="field-header">
                <span class="field-label-with-action">
                  <label for="monthly-correction-rate" class="form-label">{{ "form.monthlyCorrectionRate" | t(generatedPage.locale) | safe }}</label>
                  <button id="tr-average-info" class="info-icon-button" type="button" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="{{ "form.trInfoDefault" | t(generatedPage.locale) | safe }}" aria-label="{{ "form.trInfoAria" | t(generatedPage.locale) | safe }}">?</button>
                </span>
                <span class="field-header-actions">
                  <button id="use-latest-tr" class="btn btn-link btn-sm p-0 tr-action-button" type="button">{{ "form.useTr12m" | t(generatedPage.locale) | safe }}</button>
                  <a class="small" href="https://api.bcb.gov.br/dados/serie/bcdata.sgs.226/dados/ultimos/12?formato=json" target="_blank" rel="noopener noreferrer">{{ "form.viewTr" | t(generatedPage.locale) | safe }}</a>
                </span>
              </div>
              <div class="input-group correction-rate-group has-validation">
                <input id="monthly-correction-rate" name="monthlyCorrectionRate" class="form-control" type="text" inputmode="decimal" autocomplete="off" placeholder="{{ generatedPage.locale | numberPlaceholder }}" aria-describedby="monthly-correction-rate-help monthly-correction-rate-error">
                <span class="input-group-text">%</span>
                <div id="monthly-correction-rate-error" class="invalid-feedback"></div>
              </div>
              <div id="monthly-correction-rate-help" class="form-text">{{ "form.monthlyCorrectionHelp" | t(generatedPage.locale) | safe }}</div>
            </div>

            <div class="col financing-config-field">
              <div class="field-header">
                <label for="first-due-date" class="form-label">{{ "form.firstDueDate" | t(generatedPage.locale) | safe }}</label>
              </div>
              <input id="first-due-date" name="firstDueDate" class="form-control" type="date">
            </div>

            <div class="col financing-config-field">
              <div class="field-header">
                <label for="system" class="form-label">{{ "form.system" | t(generatedPage.locale) | safe }}</label>
                <button class="info-icon-button" type="button" data-bs-toggle="modal" data-bs-target="#system-info-modal" aria-label="{{ "form.systemInfoAria" | t(generatedPage.locale) | safe }}">?</button>
              </div>
              <select id="system" name="system" class="form-select">
                <option value="sac">SAC</option>
                <option value="price">Price</option>
              </select>
            </div>

            <div id="custom-correction-field" class="col financing-config-field financing-config-field-wide d-none">
              <div class="field-header">
                <label for="monthly-correction-series" class="form-label">{{ "form.customSeries" | t(generatedPage.locale) | safe }}</label>
              </div>
              <textarea id="monthly-correction-series" name="monthlyCorrectionSeries" class="form-control" rows="3" inputmode="decimal" placeholder="{{ generatedPage.locale | correctionSeriesPlaceholder | safe }}" aria-describedby="monthly-correction-series-help monthly-correction-series-error"></textarea>
              <div id="monthly-correction-series-error" class="invalid-feedback"></div>
              <div id="monthly-correction-series-help" class="form-text">{{ "form.customSeriesHelp" | t(generatedPage.locale) | safe }}</div>
            </div>
          </div>
        </section>

        <section class="surface-card mb-4" aria-labelledby="extras-title">
          <div class="section-heading align-items-start">
            <div>
              <span class="section-kicker">{{ "extras.kicker" | t(generatedPage.locale) | safe }}</span>
              <h2 id="extras-title">{{ "extras.title" | t(generatedPage.locale) | safe }}</h2>
              <p class="section-description">{{ "extras.description" | t(generatedPage.locale) | safe }}</p>
            </div>
            <button id="add-extra" class="btn btn-outline-primary flex-shrink-0" type="button">{{ "extras.add" | t(generatedPage.locale) | safe }}</button>
          </div>

          <div id="extras-empty" class="empty-state">
            <div class="empty-icon" aria-hidden="true">+</div>
            <p class="mb-0">{{ "extras.empty" | t(generatedPage.locale) | safe }}</p>
          </div>
          <div id="extras-list" class="vstack gap-3"></div>
        </section>

        <div id="form-alert" class="alert alert-danger d-none" role="alert" aria-live="assertive"></div>

      </form>

      <div id="results" class="d-none" aria-live="polite">
        <section class="print-report-header print-only" aria-label="{{ "print.reportHeaderLabel" | t(generatedPage.locale) | safe }}">
          <img src="{{ "assets/image/logo.png" | assetHref(generatedPage) }}" alt="Logo" class="print-report-logo">
          <div>
            <h2>{{ "metadata.title" | t(generatedPage.locale) | safe }}</h2>
          </div>
        </section>

        <section id="print-parameters" class="surface-card print-only mb-4" aria-labelledby="print-parameters-title">
          <div class="section-heading">
            <div>
              <span class="section-kicker">{{ "print.parametersKicker" | t(generatedPage.locale) | safe }}</span>
              <h2 id="print-parameters-title">{{ "print.parametersTitle" | t(generatedPage.locale) | safe }}</h2>
            </div>
          </div>
          <table class="table print-parameters-table mb-0">
            <tbody id="print-parameters-body"></tbody>
          </table>
        </section>

        <section class="mb-5" aria-labelledby="summary-title">
          <div class="section-heading">
            <div>
              <span class="section-kicker">{{ "results.kicker" | t(generatedPage.locale) | safe }}</span>
              <h2 id="summary-title">{{ "results.title" | t(generatedPage.locale) | safe }}</h2>
            </div>
          </div>
          <div id="simulation-warning" class="alert alert-warning d-none no-print" role="status"></div>
          <div id="summary-grid" class="row g-3"></div>
          <table class="table print-summary-table print-only mb-0">
            <tbody id="print-summary-body"></tbody>
          </table>
          <p id="projection-note" class="text-secondary small mt-3 mb-0 d-none">{{ "results.projectionNote" | t(generatedPage.locale) | safe }}</p>
        </section>

        <section class="surface-card mb-5" aria-labelledby="summary-detail-title">
          <div class="section-heading">
            <div>
              <span class="section-kicker">{{ "results.kicker" | t(generatedPage.locale) | safe }}</span>
              <h2 id="summary-detail-title">{{ "summary.detailsTitle" | t(generatedPage.locale) | safe }}</h2>
            </div>
          </div>
          <div class="table-responsive">
            <table id="summary-detail-table" class="table comparison-table summary-detail-table align-middle mb-0">
              <thead><tr><th scope="col">{{ "comparison.indicator" | t(generatedPage.locale) | safe }}</th><th scope="col">{{ "summary.value" | t(generatedPage.locale) | safe }}</th><th scope="col">{{ "comparison.indicator" | t(generatedPage.locale) | safe }}</th><th scope="col">{{ "summary.value" | t(generatedPage.locale) | safe }}</th></tr></thead>
              <tbody id="summary-detail-body"></tbody>
            </table>
          </div>
        </section>

        <section class="surface-card chart-section mb-5" aria-labelledby="charts-title">
          <div class="section-heading">
            <div>
              <span class="section-kicker">{{ "charts.kicker" | t(generatedPage.locale) | safe }}</span>
              <h2 id="charts-title">{{ "charts.title" | t(generatedPage.locale) | safe }}</h2>
            </div>
          </div>
          <div id="charts-status" class="chart-status" role="status" aria-live="polite"></div>
          <div class="charts-grid">
            <div class="chart-panel">
              <h3>{{ "charts.debtTitle" | t(generatedPage.locale) | safe }}</h3>
              <div class="chart-wrap">
                <canvas id="debt-chart" aria-label="{{ "charts.debtAria" | t(generatedPage.locale) | safe }}" role="img"></canvas>
              </div>
            </div>
            <div class="chart-panel">
              <h3>{{ "charts.compositionTitle" | t(generatedPage.locale) | safe }}</h3>
              <div class="chart-wrap">
                <canvas id="composition-chart" aria-label="{{ "charts.compositionAria" | t(generatedPage.locale) | safe }}" role="img"></canvas>
              </div>
            </div>
            <div class="chart-panel">
              <h3>{{ "charts.paymentTitle" | t(generatedPage.locale) | safe }}</h3>
              <div class="chart-wrap">
                <canvas id="payment-chart" aria-label="{{ "charts.paymentAria" | t(generatedPage.locale) | safe }}" role="img"></canvas>
              </div>
            </div>
            <div class="chart-panel">
              <h3>{{ "charts.costsTitle" | t(generatedPage.locale) | safe }}</h3>
              <div class="chart-wrap">
                <canvas id="costs-chart" aria-label="{{ "charts.costsAria" | t(generatedPage.locale) | safe }}" role="img"></canvas>
              </div>
            </div>
          </div>
        </section>

        <section class="surface-card mb-5" aria-labelledby="comparison-title">
          <div class="section-heading">
            <div>
              <span class="section-kicker">{{ "comparison.kicker" | t(generatedPage.locale) | safe }}</span>
              <h2 id="comparison-title">{{ "homeComparison.kicker" | t(generatedPage.locale) | safe }}</h2>
            </div>
          </div>
          <div class="table-responsive">
            <table class="table comparison-table align-middle mb-0">
              <thead><tr><th scope="col">{{ "comparison.indicator" | t(generatedPage.locale) | safe }}</th><th scope="col">{{ "comparison.withoutExtras" | t(generatedPage.locale) | safe }}</th><th scope="col">{{ "comparison.withExtras" | t(generatedPage.locale) | safe }}</th><th scope="col">{{ "comparison.difference" | t(generatedPage.locale) | safe }}</th></tr></thead>
              <tbody id="comparison-body"></tbody>
            </table>
          </div>
        </section>
      </div>

      <section class="surface-card installments-section mb-4" aria-labelledby="installments-title">
        <div class="section-heading">
          <div>
            <span class="section-kicker">{{ "installments.kicker" | t(generatedPage.locale) | safe }}</span>
            <h2 id="installments-title">{{ "installments.title" | t(generatedPage.locale) | safe }}</h2>
          </div>
          <div class="section-actions">
            <div class="dropdown no-print">
              <button id="export-csv" class="btn btn-outline-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" disabled>{{ "results.exportCsv" | t(generatedPage.locale) | safe }}</button>
              <ul class="dropdown-menu" aria-labelledby="export-csv">
                <li><button class="dropdown-item" type="button" data-csv-mode="formatted">{{ "results.exportCsvFormatted" | t(generatedPage.locale) | safe }}</button></li>
                <li><button class="dropdown-item" type="button" data-csv-mode="raw">{{ "results.exportCsvRaw" | t(generatedPage.locale) | safe }}</button></li>
              </ul>
            </div>
          </div>
        </div>

        <div id="table-empty" class="empty-state">{{ "installments.emptyPrompt" | t(generatedPage.locale) | safe }}</div>

        <div id="table-content" class="d-none">
          <div class="table-controls row g-3 align-items-end">
            <div class="col-sm-6 col-lg-4">
              <label for="installment-filter" class="form-label">{{ "installments.show" | t(generatedPage.locale) | safe }}</label>
              <select id="installment-filter" class="form-select">
                <option value="all">{{ "installments.filterAll" | t(generatedPage.locale) }}</option>
                <option value="extras">{{ "installments.filterExtras" | t(generatedPage.locale) | safe }}</option>
              </select>
            </div>
            <div class="col-sm-6 col-lg-3">
              <label for="go-to-installment" class="form-label">{{ "installments.goTo" | t(generatedPage.locale) | safe }}</label>
              <div class="input-group">
                <input id="go-to-installment" class="form-control" type="number" min="1" step="1" inputmode="numeric">
                <button id="go-button" class="btn btn-outline-secondary" type="button">{{ "installments.go" | t(generatedPage.locale) }}</button>
              </div>
            </div>
            <div class="col-sm-6 col-lg-3">
              <label for="page-size" class="form-label">{{ "installments.pageSize" | t(generatedPage.locale) | safe }}</label>
              <select id="page-size" class="form-select">
                <option value="12">12</option>
                <option value="24">24</option>
                <option value="60">60</option>
                <option value="all">{{ "installments.pageSizeAll" | t(generatedPage.locale) }}</option>
              </select>
            </div>
          </div>

          <div class="installments-table-wrap" tabindex="0" aria-label="{{ "installments.tableAria" | t(generatedPage.locale) | safe }}">
            <table class="table installments-table table-hover align-middle mb-0">
              <thead>
                <tr class="print-table-brand-row">
                  <th colspan="14" scope="colgroup">
                    <span class="print-table-brand">
                      <img src="{{ "assets/image/logo.png" | assetHref(generatedPage) }}" alt="" class="print-table-brand-logo">
                      <span>{{ "metadata.title" | t(generatedPage.locale) | safe }}</span>
                    </span>
                  </th>
                </tr>
                <tr class="print-table-title-row">
                  <th colspan="14" scope="colgroup">
                    <span class="section-kicker">{{ "installments.kicker" | t(generatedPage.locale) | safe }}</span>
                    <span class="print-table-title">{{ "installments.title" | t(generatedPage.locale) | safe }}</span>
                  </th>
                </tr>
                <tr><th scope="col">{{ "charts.installmentAxis" | t(generatedPage.locale) | safe }}</th><th scope="col">{{ "installments.col.date" | t(generatedPage.locale) | safe }}</th><th scope="col">{{ "installments.col.openingBalance" | t(generatedPage.locale) | safe }}</th><th scope="col">{{ "installments.col.correctionRate" | t(generatedPage.locale) | safe }}</th><th scope="col">{{ "form.correctionMode" | t(generatedPage.locale) | safe }}</th><th scope="col">{{ "installments.col.correctedBalance" | t(generatedPage.locale) | safe }}</th><th scope="col">{{ "charts.interest" | t(generatedPage.locale) | safe }}</th><th scope="col" title="{{ "installments.regularAmortizationTitle" | t(generatedPage.locale) | safe }}">{{ "installments.col.regularAmortization" | t(generatedPage.locale) | safe }}</th><th scope="col">{{ "installments.col.regularPayment" | t(generatedPage.locale) | safe }}</th><th scope="col">{{ "extras.cardTitle" | t(generatedPage.locale) | safe }}</th><th scope="col">{{ "charts.monthlyExtraCosts" | t(generatedPage.locale) | safe }}</th><th scope="col">{{ "installments.col.totalPayment" | t(generatedPage.locale) | safe }}</th><th scope="col">{{ "installments.col.closingBalance" | t(generatedPage.locale) | safe }}</th><th scope="col">{{ "installments.col.extraGoal" | t(generatedPage.locale) | safe }}</th></tr>
              </thead>
              <tbody id="installments-body"></tbody>
            </table>
          </div>

          <div class="pagination-bar">
            <span id="page-status" class="text-secondary"></span>
            <div class="btn-group" role="group" aria-label="{{ "installments.paginationAria" | t(generatedPage.locale) | safe }}">
              <button id="previous-page" class="btn btn-outline-secondary" type="button">{{ "installments.previous" | t(generatedPage.locale) | safe }}</button>
              <button id="next-page" class="btn btn-outline-secondary" type="button">{{ "installments.next" | t(generatedPage.locale) | safe }}</button>
            </div>
          </div>
        </div>
      </section>

      <section class="surface-card no-print mb-4" aria-labelledby="home-comparison-title">
        <div class="section-heading">
          <div>
            <span id="home-comparison-kicker" class="section-kicker">{{ "homeComparison.kicker" | t(generatedPage.locale) | safe }}</span>
            <h2 id="home-comparison-title">{{ "homeComparison.title" | t(generatedPage.locale) | safe }}</h2>
            <p id="home-comparison-description" class="section-description">{{ "homeComparison.description" | t(generatedPage.locale) | safe }}</p>
          </div>
          <div class="section-actions">
            <a id="home-comparison-link" class="btn btn-outline-primary" href="{{ generatedPage | homeComparisonHref }}">{{ "homeComparison.cta" | t(generatedPage.locale) }}</a>
          </div>
        </div>
      </section>

      {% set featuredBasics = collections.guides | contentById('financing-basics', generatedPage.locale) %}
      {% set featuredSystems = collections.guides | contentById('sac-or-price', generatedPage.locale) %}
      {% set featuredAmortization = collections.guides | contentById('term-or-payment', generatedPage.locale) %}
      <section class="surface-card no-print mb-4" aria-labelledby="home-guides-title">
        <div class="section-heading">
          <div>
            <span id="home-guides-kicker" class="section-kicker">{{ 'guides.homeKicker' | t(generatedPage.locale) }}</span>
            <h2 id="home-guides-title">{{ 'guides.homeTitle' | t(generatedPage.locale) }}</h2>
            <p id="home-guides-description" class="section-description">{{ 'guides.homeDescription' | t(generatedPage.locale) }}</p>
          </div>
          <div class="section-actions">
            <a id="home-guides-link" class="btn btn-outline-primary" href="{{ 'guides' | pageHref(generatedPage) }}" data-route="guides">{{ 'guides.homeCta' | t(generatedPage.locale) }}</a>
          </div>
        </div>
        <div class="content-card-grid content-card-grid-featured home-guides-grid">
          {% for guide in [featuredBasics, featuredSystems, featuredAmortization] %}
            <article class="content-card">
              <span class="content-card-category">{{ ('guides.category.' + guide.data.category) | t(generatedPage.locale) }}</span>
